# ==================== NoneBot2 基础配置 ====================
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
# 必须与 NapCat「反向 WS」里填的 Token 完全一致
# 注意：只能用 ASCII 字符（字母数字下划线），不要写中文——
# HTTP 头不允许非 ASCII 字符，中文 Token 会让握手直接失败
ONEBOT_ACCESS_TOKEN=qbot_改成你自己的随机字符串
COMMAND_START=["/"]

# ==================== 大模型接入 ====================
# 方案 A：小米 MiMo（推荐，1M 上下文 + 原生多模态）
AI_API_BASE=https://api.xiaomimimo.com/v1
AI_API_KEY=sk-你的MiMoKey
AI_MODEL=mimo-v2.6-flash

# 方案 B：智谱 GLM（有完全免费的 glm-4-flash-250414）
# AI_API_BASE=https://open.bigmodel.cn/api/paas/v4
# AI_API_KEY=你的智谱Key
# AI_MODEL=glm-4.5-air

# 方案 C：阿里云百炼（新用户送 7000 万 Token）
# AI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_API_KEY=sk-你的百炼APIKey
# AI_MODEL=qwen-flash

# 方案 D：本机 Ollama 跑 Qwen3.5-9B
# 需要先 ollama serve，并确保 Ollama 已加载 qwen3.5:9b
# AI_API_BASE=http://127.0.0.1:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=qwen3.5:9b

# ---- 常见平台的接口地址备查 ----
# 小米 MiMo      https://api.xiaomimimo.com/v1
# 智谱 GLM       https://open.bigmodel.cn/api/paas/v4
# 阿里云百炼     https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek 官方  https://api.deepseek.com/v1
# 硅基流动       https://api.siliconflow.cn/v1
# 月之暗面       https://api.moonshot.cn/v1
# 火山方舟       https://ark.cn-beijing.volces.com/api/v3
# 第三方中转站   填中转站文档里给的地址，一般以 /v1 结尾

# ---- 模型请求代理（只有用国外 API 才需要）----
# GPT / Gemini 这类国外 API 国内直连不通，开了梯子后把本机代理端口填这里：
# AI_PROXY=http://127.0.0.1:7890
# 注意：①只对模型请求生效，不影响机器人其他功能 ②DeepSeek/GLM/通义等国内
# API 不要填，代理没开时填了会导致模型调用全部失败 ③Clash 混合端口一般是
# 7890，v2rayN 的 http 端口一般是 10809，以你的代理软件实际显示为准。

# ==================== 思考模式（群聊延迟的决定性开关）====================
# 关掉思考。实测 GLM 全系与 MiMo v2.6 都认 thinking:{"type":"disabled"}，
# 关掉后延迟从 4-9 秒降到 1-2 秒，且思考不再占用 AI_MAX_TOKENS。
AI_DISABLE_THINKING=true

# 思考强度，可选 low / high / max，留空表示不传该参数。
# 这是给「不支持关闭思考、只能调档」的模型用的，例如 GLM-5.3 系列。
# 注意：实测 MiMo v2.6-flash 会静默忽略本参数（传了不报错也不生效）。
AI_REASONING_EFFORT=

AI_TEMPERATURE=0.8
AI_MAX_TOKENS=400

# ==================== 联网搜索（默认关闭，因为贵）====================
# 开启前必须先在 MiMo 控制台 → 插件管理 开通「联网服务插件」，否则会 400。
# 未开通也不会崩：程序识别到这个错误后会自动降级成普通对话。
# 计费 = 插件调用次数（¥16 / 1000 次）+ 网页正文带来的额外 token。
# 一轮搜索会按 max_keyword 的数量并发调用，所以一次提问可能消耗好几次调用。
AI_WEB_SEARCH_ENABLED=false
# true = 每句都联网（更贵）；false = 由模型自己判断要不要联网
AI_WEB_SEARCH_FORCE=false
# 一轮搜索最多同时发几个关键词，直接决定调用次数与成本
AI_WEB_SEARCH_MAX_KEYWORD=2
# 什么时候允许联网：
#   auto   = 只有消息里出现时效性关键词（今天/最新/天气/股价/新闻…）才联网（推荐）
#   always = 每条消息都允许联网，覆盖最全但每条消息都多等约 1.2 秒
# 关键词表在 plugins/ai_chat/websearch.py 的 WEB_SEARCH_KEYWORDS。
AI_WEB_SEARCH_TRIGGER=auto
# 每天最多用多少次联网插件（全局共享，所有群加起来算）。
# 计数取官方返回的真实计费次数 web_search_usage.tool_usage：
#   一轮搜索若用 2 个关键词就计 2 次；模型判断无需联网则计 0 次，不扣额度。
# 用尽后自动停止联网（对话照常进行），次日零点自动恢复。设 0 = 完全不允许联网。
AI_WEB_SEARCH_DAILY_LIMIT=30

# ==================== 人设与记忆 ====================
# 人设（吉普莉尔）写在 plugins/ai_chat/config.py 的 ai_system_prompt 字段里
# 每群保留的对话轮数：轮数越多上下文越连贯，输入 token 也越贵（每轮约 +5%）
AI_HISTORY_ROUNDS=12

# ==================== 对话衔接（群聊背景）====================
# 把没 @ 机器人的最近群聊记进内存环形缓冲，@ 它时作为背景注入，
# 「群里聊了一阵再 @ 它接着问」也能接得上话。重启机器人后背景清空（属正常）。
AI_AMBIENT_ENABLED=true
# 注入最近几条群聊（太多会稀释注意力、涨 token）
AI_AMBIENT_CONTEXT_COUNT=6

# ==================== 群资源检索（群文件 + 群相册）====================
AI_FILE_SEARCH_ENABLED=true
AI_FILE_INDEX_TTL=600
AI_FILE_MAX_RESULTS=15

# ==================== 群精华消息 ====================
AI_ESSENCE_ENABLED=true
AI_ESSENCE_INDEX_TTL=900
AI_ESSENCE_MAX_RESULTS=10

# ==================== 群成员识别 ====================
# 开启后：
#   1. 消息里 @ 了别人，机器人能知道 @ 的是谁（@ 段默认会被整个丢掉）
#   2. 正文里直接打了群名片/昵称（如「小a怎么样」），也能认出是群里的小a
AI_MEMBER_ENABLED=true
# 成员名单缓存秒数。群成员变动不频繁，可以设长一点；
# 代价是新人入群后最多这么久内认不出来。
AI_MEMBER_INDEX_TTL=1800
# 一条消息里最多把几个成员的资料交给模型
AI_MEMBER_MAX_RESULTS=5

# ==================== 新成员入群欢迎 ====================
# 有人入群时用模型生成一句欢迎语（失败自动退回写死的模板）。
# 注意：这是「主动发消息」，客观上会提高被 QQ 风控盯上的概率。介意就改成 false。
AI_WELCOME_ENABLED=true
# 同群两次欢迎的最小间隔（秒）。一次拉一群人进群时只会欢迎第一个。
AI_WELCOME_COOLDOWN=15
# 每个群每天最多欢迎几次
AI_WELCOME_DAILY_LIMIT=20

# ==================== 识图（多模态）====================
# 模型必须支持图片输入，否则收到图会 400
AI_VISION_ENABLED=true
AI_VISION_MAX_IMAGES=3
AI_VISION_DEFAULT_PROMPT=看看这张图，说说里面有什么
AI_VISION_IMAGE_MODE=url

# ==================== 表情包 ====================
AI_STICKER_ENABLED=true
AI_STICKER_DIR=stickers
# 0 = 只在别人明确索要时才发
AI_STICKER_PROBABILITY=0

# ==================== 账号收藏表情 ====================
# 用机器人 QQ 账号里收藏的表情包发表情（NapCat fetch_custom_face 拉列表，
# 发送时把 URL 交给 NapCat 下载）。收藏为空或不支持该 API 时自动退回本地
AI_ACCOUNT_FACE_ENABLED=true
# 每次拉多少条收藏（上限以账号实际收藏数为准）
AI_ACCOUNT_FACE_COUNT=200
# 明确索要「表情包」时优先发账号收藏（false = 明确索要时只用本地）
AI_ACCOUNT_FACE_ON_REQUEST=true
# 语义匹配 / 随机附带场景下，账号收藏的出场概率（0~1）
AI_ACCOUNT_FACE_MIX=0.5

# ==================== 防封号限流 ====================
# 同一群两次回复的最小间隔（秒）。3 秒是衔接感与防刷屏的平衡值：
# 太长会把用户紧接着的追问静默吞掉（观感是「接不上话」），担心风控可调回 5~10
AI_COOLDOWN=3
AI_DAILY_LIMIT=200
# 留空 = 所有群都能用。填了就只有列表里的群能用，例如 [123456789, 987654321]
AI_GROUP_WHITELIST=[]

# ==================== 交互 ====================
AI_REPLY_QUOTE=true


# ==================== 群文件内容检索（RAG）====================
 群文件内容检索（RAG）====================
# 不止「文件在哪」，还能回答「文件里写了什么」：
# 下载可读的文档（txt/md/docx/pdf 等）抽文字、分块、建索引
AI_FILETEXT_ENABLED=true
# 最多给多少个文件建内容索引
AI_FILETEXT_MAX_FILES=20
# 单个文件超过这个大小（字节）就不下载，默认 8MB
AI_FILETEXT_MAX_FILE_SIZE=8388608
# 内容索引缓存秒数（抽出的文本落盘，重启不用重新下载）
AI_FILETEXT_TTL=1800
# 每次最多给模型看几段命中内容
AI_FILETEXT_MAX_RESULTS=6

# ---- 腾讯文档 OpenAPI（群链接收藏自动收录）----
# 去 docs.qq.com/open 注册开发者，审核通过后首页「开发者信息」里直接复制三样：
# client_id(应用ID)、access_token（30 天有效，过期点「重置」重新生成）、open_id
AI_DOCS_CLIENT_ID=
AI_DOCS_ACCESS_TOKEN=
AI_DOCS_OPEN_ID=
# 链接自动同步进在线文档的过滤：all=全部同步 / whitelist=只收白名单域名（默认，内置常用站）/ manual=全手动
AI_DOCS_SYNC_MODE=whitelist
# 全局默认白/黑名单（逗号分隔域名；群内用 /文档过滤 可单独覆盖）
AI_DOCS_DOMAIN_WHITELIST=
AI_DOCS_DOMAIN_BLACKLIST=

# ==================== AI 生图表情包（可选）====================
# 结合群聊话题即兴画表情包；也可以 @机器人「画一张X」点名作画
#（说「自画像/卖萌」画它自己，「小鸟/风景」就画内容）。
# 生图接口和上面的对话模型是两套（OpenAI 兼容的生图接口），互不影响。
# 不填 / 保持 false 完全不影响其他功能。
AI_IMAGEGEN_ENABLED=false
# 常见备查：OpenAI 官方 https://api.openai.com/v1
#           第三方中转站填它文档里给的地址，一般以 /v1 结尾
AI_IMAGEGEN_API_BASE=
AI_IMAGEGEN_API_KEY=
# gpt-image 系列（gpt-image-1 / dall-e-3 等，看所用平台支持哪些）
AI_IMAGEGEN_MODEL=gpt-image-1
# low 快 / high 细节多但慢一截
AI_IMAGEGEN_QUALITY=low
# 可选 1024x1024（方形表情包）/ 1024x1536（竖）/ 1536x1024（横）
AI_IMAGEGEN_SIZE=1024x1024
# 即兴作画概率（0~1）：命中主动搭话时按这个概率改去画画
AI_IMAGEGEN_PROBABILITY=0.08
# 每日张数上限（防烧钱）
AI_IMAGEGEN_DAILY_LIMIT=30
# 角色参考图（可选）：放一张角色立绘到 assets/jibril_reference.png，
# 或在配置页面「AI 生图」面板上传。有它 = 形象锁定只换表情；没有 = 纯文字描述
AI_IMAGEGEN_REF_IMAGE=
