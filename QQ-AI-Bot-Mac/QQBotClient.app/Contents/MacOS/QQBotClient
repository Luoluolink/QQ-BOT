#!/bin/bash
# QQ 机器人客户端：由 LaunchServices（双击 / open）拉起。
# 不经过终端 —— pywebview 窗口所需的 GUI 会话权限由 LaunchServices 天然赋予，
# 这也是把它做成 .app 的原因（裸 python 从守护上下文起窗口会被 macOS 拒绝）。
#
# 本体约定：.app 放在项目根目录（和 launcher.py、.venv 同级）；
# /Applications 里放的是指向本体的符号链接 —— 所以先把 $0 的链接
# 一路解到真实路径，再按「MacOS 上三级 = 项目根」定位。
SRC="$0"
while [ -L "$SRC" ]; do
  DIR="$(cd "$(dirname "$SRC")" && pwd)"
  SRC="$(readlink "$SRC")"
  case "$SRC" in
    /*) ;;                    # 绝对路径链接
    *) SRC="$DIR/$SRC" ;;     # 相对路径链接
  esac
done
ROOT="$(cd "$(dirname "$SRC")/../../.." && pwd -P)"
cd "$ROOT" || exit 1
mkdir -p logs
exec .venv/bin/python launcher.py --app-child --web-port 8900 >> logs/launcher_client.log 2>&1
