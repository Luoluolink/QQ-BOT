#!/bin/bash
# QQ·个人：一键打开/聚焦「第二个 QQ 实例」（你自己的账号）。
# 数据目录与机器人的 QQ 完全隔离，两边互不干扰。
DATA="$HOME/Library/Containers/com.tencent.qq/Data/Documents/qq-personal"
PID=$(pgrep -f "user-data-dir=$DATA" | head -1)
if [ -n "$PID" ]; then
  # 已在运行：拽到前台
  osascript -e "tell application \"System Events\" to set frontmost of (first application process whose unix id is $PID) to true" >/dev/null 2>&1
  exit 0
fi
mkdir -p "$DATA"
exec /Applications/QQ.app/Contents/MacOS/QQ --no-sandbox --user-data-dir="$DATA"
