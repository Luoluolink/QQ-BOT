#!/bin/bash
# QQ·个人：一键打开/聚焦「第二个 QQ 实例」（你自己的账号）。
# 数据目录与机器人的 QQ 完全隔离。本应用是 LSUIElement 代理：
# 不占 Dock，点了之后你的 QQ 窗口会自己到最前面。
DATA="$HOME/Library/Containers/com.tencent.qq/Data/Documents/qq-personal"
PID=$(pgrep -f "MacOS/QQ --no-sandbox --user-data-dir=$DATA" | head -1)
if [ -n "$PID" ]; then
  if osascript -e "tell application \"System Events\" to set frontmost of (first application process whose unix id is $PID) to true" 2>/dev/null; then
    exit 0
  fi
  # 聚焦失败 = 自动化权限没给。弹窗指路，不静默装死。
  osascript -e 'display dialog "把 QQ 窗口调到前面需要授权一次：\n系统设置 → 隐私与安全性 → 自动化 → 打开 QQPersonal" buttons {"好"} default button 1 with title "QQ·个人"' >/dev/null 2>&1
  exit 0
fi
mkdir -p "$DATA"
exec /Applications/QQ.app/Contents/MacOS/QQ --no-sandbox --user-data-dir="$DATA"
