# ============================================================================
# QQ 群 AI 机器人 · 配置参考
#
# 这个文件是「参数说明书」，不用改它。
# 机器人真正读取的是同目录的 .env —— 那个文件由启动器自动生成。
#
# 想手工调参数：改 .env 里对应的行，然后重新运行启动器（或重启机器人）。
# 想加一个 .env 里没有的参数：把下面某一行连同注释一起复制到 .env 里改。
#
# 变量名规则：config.py 里的字段名大写。
#   例如 ai_cooldown  ->  AI_COOLDOWN
# ============================================================================


# ---------------------------------------------------------------- NoneBot2 基础

DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080

# 机器人核心与 NapCat 之间的握手口令，两边必须完全一致。
# 启动器会自动生成并同步到 NapCat 的 onebot11.json，通常不用手动管。
#
# ⚠️ 只能用 ASCII 字符（字母数字下划线）。
#    HTTP 头不允许非 ASCII 字符，写成中文会让握手直接失败（403），
#    而报错信息只会说「连接被拒绝」，很难往这个方向想。
ONEBOT_ACCESS_TOKEN=qbot_change_me

# 命令前缀。改成 ["", "/"] 就同时支持带不带斜杠两种写法
COMMAND_START=["/"]


# ---------------------------------------------------------------- 机器人身份

# 机器人登录用的 QQ 号。
# 填了它，NapCat 会先尝试快速登录（省掉扫码）；失败会自动退回二维码，不会卡住。
BOT_QQ=

# 机器人的名字。会拼进系统提示词，让它知道自己叫什么。
# 启动器网页里的「机器人名字」写的就是这一项。
AI_BOT_NAME=小助手


# ---------------------------------------------------------------- 大模型接入

# 任何「OpenAI 兼容」的平台都行，填到 /v1 为止（末尾不要带斜杠）：
#
#   小米 MiMo      https://api.xiaomimimo.com/v1
#   智谱 GLM       https://open.bigmodel.cn/api/paas/v4
#   阿里云百炼      https://dashscope.aliyuncs.com/compatible-mode/v1
#   DeepSeek       https://api.deepseek.com/v1
#   本机 Ollama    http://127.0.0.1:11434/v1
AI_API_BASE=https://api.xiaomimimo.com/v1

AI_API_KEY=

# 模型 ID，以平台控制台里的模型列表为准。几个常用组合：
#
#   mimo-v2.6-flash          1.1~2.6s  原生多模态 + 可联网，性价比好
#   glm-4.5-air              0.8~2.7s  便宜、稳
#   glm-4-flash-250414       约 0.5s   完全免费，适合先试水（纯文本，不支持识图）
#   qwen-plus                通义千问，额度大方
#   deepseek-chat            便宜但纯文本，不支持识图
#
# ⚠️ 换成纯文本模型时，记得把下面的 AI_VISION_ENABLED 改成 false，
#    否则模型收到图片会直接返回 400。
AI_MODEL=mimo-v2.6-flash

# 官方默认值，可调范围 [0, 1.5]。
# 实测 1.5 会输出语无伦次的内容，建议 0.7~1.0。
AI_TEMPERATURE=0.8
AI_MAX_TOKENS=400


# ---------------------------------------------------------------- 思考模式（群聊延迟的决定性开关）

# 关掉思考模式。这是群聊体验最重要的一项：
# 实测同一问题从 4.6~9.1 秒降到 1.1~2.1 秒，差 4 倍左右。
#
# 实测 GLM 全系与 MiMo v2.6 都认这个字段，换厂商不用改代码。
AI_DISABLE_THINKING=true

# 思考强度 low / high / max，留空 = 不传。
# 这是给「不支持关闭思考、只能调档」的模型用的，例如 GLM-5.3 系列。
#
# ⚠️ 注意区分：MiMo v2.6-flash 会静默忽略本参数（传了不报错，但也不生效），
#    所以要关思考必须靠上面的 AI_DISABLE_THINKING。
AI_REASONING_EFFORT=


# ---------------------------------------------------------------- 联网搜索

# 需要先去模型厂商控制台开通「联网服务插件」，否则传 tools 会直接 400。
# 没开通也不会让机器人挂掉 —— 程序识别到这个错误后会自动降级成普通对话。
#
# 计费 = 插件调用次数（MiMo 为 ¥16 / 1000 次）+ 网页正文拼进提示词带来的额外 token。
# 一轮搜索会按下面的 max_keyword 同时搜多个关键词，
# 也就是一次提问可能消耗好几次调用，所以用每日额度把总量卡死。
AI_WEB_SEARCH_ENABLED=false

# true = 每句都联网（更贵）；false = 由模型自己判断要不要联网
AI_WEB_SEARCH_FORCE=false

# 一轮搜索最多同时发几个关键词，直接决定调用次数与成本
AI_WEB_SEARCH_MAX_KEYWORD=2

# 什么时候允许联网：
#   auto   = 只有消息里出现时效性关键词（今天/最新/天气/股价/新闻…）才联网（推荐）
#   always = 每条消息都允许联网，覆盖最全
#
# 为什么默认 auto：挂上联网参数后服务端每次都要先判断一轮，实测每条消息
# 要多等约 1.2 秒 —— 哪怕最后根本没联网。日常闲聊不值得付这个代价。
# 关键词表在 plugins/ai_chat/websearch.py 的 WEB_SEARCH_KEYWORDS。
# 想强制某一句联网，直接说「搜一下 XXX」即可命中。
AI_WEB_SEARCH_TRIGGER=auto

# 每天最多用多少次联网插件（全局共享，所有群加起来算）。
# 计数取的是官方响应里的真实计费次数 web_search_usage.tool_usage：
#   一轮搜索用 2 个关键词就计 2 次；模型判断无需联网则计 0 次，不扣额度。
# 用尽后自动停止联网（对话照常进行），次日零点自动恢复。
# 设 0 = 完全不允许联网。随时可以在群里发 /search 查看今天还剩多少。
AI_WEB_SEARCH_DAILY_LIMIT=30


# ---------------------------------------------------------------- 人设

# 人设也可以直接写在这里。写了就会覆盖 plugins/ai_chat/config.py 里的默认值。
#
# 这里**只写性格和说话方式**就行，不用操心防幻觉的约束 ——
# 「不许编造文件名」那几条（IRON_RULES）由代码无条件附加在系统提示词最后，
# 优先级高于人设，你在网页里怎么写都不会把它覆盖掉。
#
# ⚠️ 多行内容要写成一行，换行用 \n 表示，整体用双引号包住。
#    启动器网页里填的人设就是按这个格式写进来的。
# AI_SYSTEM_PROMPT="你是这个 QQ 群里的 AI 助手。\n\n【性格】\n友好、耐心，说话自然。\n\n【说话方式】\n简洁，不超过 100 字。"

# 每个群保留的对话轮数（1 轮 = 1 问 + 1 答）
AI_HISTORY_ROUNDS=8


# ---------------------------------------------------------------- 群资源检索（群文件 + 群相册）

# 开启后，群友问「群里有没有 XX」机器人会去翻群文件和群相册，并说清在哪个文件夹
AI_FILE_SEARCH_ENABLED=true
# 索引缓存秒数，超时后下次用到会自动重建
AI_FILE_INDEX_TTL=600
# 单次最多把多少条候选资源交给模型
AI_FILE_MAX_RESULTS=15


# ---------------------------------------------------------------- 群精华消息

AI_ESSENCE_ENABLED=true
AI_ESSENCE_INDEX_TTL=900
AI_ESSENCE_MAX_RESULTS=10


# ---------------------------------------------------------------- 群成员识别

# 开启后：
#   1. 消息里 @ 了别人，机器人能知道 @ 的是谁（@ 段默认会被整个丢掉，必须单独还原）
#   2. 正文里直接打了群名片/昵称（如「小a怎么样」），也能认出是群里的小a
AI_MEMBER_ENABLED=true
# 成员名单缓存秒数。群成员变动不频繁，可以设长一点；
# 代价是新人入群后最多这么久内认不出来。
AI_MEMBER_INDEX_TTL=1800
# 一条消息里最多把几个成员的资料交给模型。
# 调大会明显增加 token，而且一长串名单反而容易让模型认错人。
AI_MEMBER_MAX_RESULTS=5


# ---------------------------------------------------------------- 新成员入群欢迎

# ⚠️ 注意：这是「主动发消息」，和「只在被 @ 时响应」的保守策略不同，
#    客观上会提高被 QQ 风控盯上的概率。介意就改成 false。
AI_WELCOME_ENABLED=true
# 同群两次欢迎的最小间隔（秒）。有人一次拉一群人进群时，
# 挨个欢迎等于短时间内连发多条消息，是风控最敏感的行为，所以默认跳过。
AI_WELCOME_COOLDOWN=15
# 每个群每天最多欢迎几次
AI_WELCOME_DAILY_LIMIT=20


# ---------------------------------------------------------------- 识图（多模态）

# 前提：模型必须支持图片输入。
# 换成纯文本模型（glm-4-flash / deepseek-chat 之类）时必须改成 false，
# 否则模型收到图片会直接返回 400。
AI_VISION_ENABLED=true
# 一条消息最多识别几张图
AI_VISION_MAX_IMAGES=3
# 只发图不配文字时，用这句代替提问
AI_VISION_DEFAULT_PROMPT=看看这张图，说说里面有什么
# url = 把图片地址给模型（推荐，省流量最快）；base64 = 编码后塞进请求体（更稳更慢）
# 无论选哪个，url 方式失败时都会自动回退 base64 重试一次
AI_VISION_IMAGE_MODE=url


# ---------------------------------------------------------------- 表情包

# 把图片丢进 stickers/ 目录就能用（支持 jpg/png/gif/webp）
AI_STICKER_ENABLED=false
AI_STICKER_DIR=stickers
# 被回复时随机附带表情包的概率。0 = 只在别人明确索要时才发
# 建议保持 0，否则每句都带图，几天就被嫌烦了
AI_STICKER_PROBABILITY=0


# ---------------------------------------------------------------- 防封号限流

# 同一群两次回复的最小间隔（秒）
AI_COOLDOWN=5
# 每个群每天最多调用多少次
AI_DAILY_LIMIT=200
# 留空 = 所有群都能用。填了就只有列表里的群能用，例如 [123456789, 987654321]
AI_GROUP_WHITELIST=[]


# ---------------------------------------------------------------- 交互

# 回复时是否引用原消息
AI_REPLY_QUOTE=true


# ---------------------------------------------------------------- 群文件内容检索（RAG）

# 不止「文件在哪」，还能回答「文件里写了什么」：
# 下载可读的文档（txt/md/docx/pdf 等）抽文字、分块、建索引
AI_FILETEXT_ENABLED=true
# 最多给多少个文件建内容索引
AI_FILETEXT_MAX_FILES=20
# 单个文件超过这个大小（字节）就不下载，默认 8MB
AI_FILETEXT_MAX_FILE_SIZE=8388608
# 内容索引缓存秒数（抽出的文本落盘，重启不用重新下载）
AI_FILETEXT_TTL=1800
# 每次最多给模型看几段命中内容
AI_FILETEXT_MAX_RESULTS=6


# ---------------------------------------------------------------- 群历史消息检索

# 「刚才谁说过 XX」——拉最近的消息建本地索引来搜
AI_HISTORY_ENABLED=true
# 索引缓存时长（秒）
AI_HISTORY_INDEX_TTL=300
# 一次最多拉多少条建索引（越多越慢）
AI_HISTORY_MAX_FETCH=300
# 单次最多展示多少条命中结果
AI_HISTORY_MAX_RESULTS=15


# ---------------------------------------------------------------- 媒体识别

# 语音转文字 / 图片 OCR（走 QQ 官方能力，不花模型的钱）
AI_MEDIA_ENABLED=true


# ---------------------------------------------------------------- 群互动

# 被戳之后要不要回戳
AI_POKE_ENABLED=true
AI_POKE_REPLY_ENABLED=true
# 被戳回应的限流：同群冷却（秒）+ 每群每日上限（主动动作，从严）
AI_POKE_COOLDOWN=10.0
AI_POKE_DAILY_LIMIT=30
# AI 语音默认音色的 character_id，留空 = 用群音色列表里的第一个。
# 不确定有什么音色就在群里发 /语音列表
AI_VOICE_CHARACTER=


# ---------------------------------------------------------------- 私聊

# 私聊也走 AI 对话（纯聊天 + 识图 + 联网）
AI_PRIVATE_ENABLED=true
# 同一人两次回复的最小间隔（秒）与每人每日上限
AI_PRIVATE_COOLDOWN=3.0
AI_PRIVATE_DAILY_LIMIT=100
# 私聊保留的对话轮数
AI_PRIVATE_HISTORY_ROUNDS=8


# ============================================================================
# 常见问题
#
# Q：机器人不回消息？
#   1. 先看 NapCat 那个窗口 —— 是不是还停在二维码界面没登录
#   2. 再看机器人核心的窗口有没有报错
#   3. 最后才怀疑代码
#
# Q：扫码报「当前账号已登录，无法重复登录」
#   QQ 客户端和 NapCat 属于同一种「电脑端」登录，同一个号不能同时登两处。
#   先在手机或电脑 QQ 上把这个号退掉，再扫。
#
# Q：扫码报「账号存在安全风险」（serverErrorCode 168）
#   这是腾讯的风控，不是配置问题。用手机 QQ 登录该号，按 App 提示完成验证，
#   等几小时到一两天再试。风控解除前别反复扫码，每次失败都可能加重风控。
#
# Q：机器人开始编造不存在的文件名
#   先确认群里那份文件确实存在（发 /files list 看索引里有没有）。
#   如果确实不存在它却说了有，那就是模型没守住 IRON_RULES ——
#   那几条由代码强制附加，不用去 .env 里找，改人设也删不掉它们。
#   真要排查，看 plugins/ai_chat/__init__.py 里的 IRON_RULES 常量。
#
# Q：每条消息都要等好几秒
#   确认 AI_DISABLE_THINKING=true。思考模式开着的话延迟会翻好几倍。
#
# Q：终端里的框线错位了
#   老式 cmd 窗口用「新宋体」时制表符会按全角渲染。
#   换成「Consolas」或「Microsoft YaHei Mono」，或者设环境变量 QQBOT_ASCII=1。
# ============================================================================

# ==================== 长期记忆（群助手核心功能）====================
# 「/记住 XXX」把事实写进 data/group_memory.json，对话时自动注入上下文
AI_MEMORY_ENABLED=true
# 每个群最多存多少条（超出挤掉最旧）
AI_MEMORY_MAX_PER_GROUP=50
# 每轮对话最多注入几条记忆
AI_MEMORY_MAX_RESULTS=8

# ==================== 人设覆盖（管理员专用）====================
# 管理员 /人设 新人设文本 给本群换人设；/人设 恢复 回默认
AI_PERSONA_OVERRIDE_ENABLED=true
# 自定义人设最小长度
AI_PERSONA_MIN_LEN=20

# ==================== 主动发言 ====================
# 群里没 @ 机器人但命中关键词时按概率插话；四道闸门：关键词→长度→概率→冷却/额度
AI_PROACTIVE_ENABLED=true
# 触发词（JSON 数组格式）
AI_PROACTIVE_KEYWORDS=["机器人", "人工智能", "AI", "吉普莉尔", "大模型", "语言模型"]
# 命中后实际回复的概率
AI_PROACTIVE_PROBABILITY=0.35
# 同群两次主动发言最小间隔（秒）
AI_PROACTIVE_COOLDOWN=300
# 每群每天最多主动发言次数
AI_PROACTIVE_DAILY_LIMIT=12
# 消息至少多长才考虑触发
AI_PROACTIVE_MIN_LEN=6

# ==================== 相册内容索引 ====================
# 存图时自动记录图片内容描述，/找图 或对话可按内容找图
AI_ALBUM_INDEX_ENABLED=true
# 每群最多索引多少张
AI_ALBUM_INDEX_MAX_PER_GROUP=300

# ==================== 链接收藏库 ====================
# 群里发的链接自动抓标题归档，/链接 检索，并同步到绑定的腾讯文档
AI_LINKARCHIVE_ENABLED=true
# 每群最多收藏多少条
AI_LINKARCHIVE_MAX_PER_GROUP=500
# 抓标题超时（秒）
AI_LINKARCHIVE_TIMEOUT=8

# ==================== 腾讯文档同步 ====================
# 对接官方 OpenAPI（docs.qq.com/open）。三步配置：
# 1. 去 docs.qq.com/open 注册开发者、创建应用，拿 Client ID/Secret
# 2. 按官方授权页发起 OAuth，扫码后用 code 换 token，把 refresh_token
#    和 open_id 填到 data/tdoc_token.json（或此处 + 重启）
# 3. 群里发 /绑定文档 文档链接 或 /创建文档 标题
# 未配置时链接收藏照常工作，只是不同步到在线文档
AI_DOCS_ENABLED=true
AI_DOCS_CLIENT_ID=
AI_DOCS_ACCESS_TOKEN=
AI_DOCS_OPEN_ID=
# 链接自动同步进在线文档的过滤：all=全部同步 / whitelist=只收白名单域名（默认，内置常用站）/ manual=全手动
AI_DOCS_SYNC_MODE=whitelist
# 全局默认白/黑名单（逗号分隔域名；群内用 /文档过滤 可单独覆盖）
AI_DOCS_DOMAIN_WHITELIST=
AI_DOCS_DOMAIN_BLACKLIST=
