# ============================================================
# 配置模板 —— 复制成 .env 再改，或者直接跑启动器（它会生成 .env）。
#
# 每一项的变量名 = plugins/ai_chat/config.py 里的字段名大写。
# 也就是说这里没列出的开关同样可以写进来，只是这份文件挑了常用的。
# 改完重启机器人生效。
# ============================================================

# ---------- NoneBot2 基础 ----------
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
# 必须与 NapCat「反向 WS」里填的 Token 完全一致。
# 只能用 ASCII 字符（字母/数字/下划线），中文会让 WS 握手直接 403
ONEBOT_ACCESS_TOKEN=qbot_please_change_me
COMMAND_START=["/"]

# 机器人登录用的 QQ 号（仅用于 NapCat 快速登录，可留空）
BOT_QQ=

# ---------- 大模型 ----------
# 任意 OpenAI 兼容接口。下面几行以小米 MiMo 为例
AI_API_BASE=https://api.xiaomimimo.com/v1
AI_API_KEY=
AI_MODEL=mimo-v2.6-flash
AI_BOT_NAME=小助手
# 关掉思考模式：群聊延迟能从 4~9 秒降到 1~2 秒
AI_DISABLE_THINKING=true
# 给「不能关思考、只能调档」的模型用（low / high / max），留空 = 不传
AI_REASONING_EFFORT=
AI_TEMPERATURE=0.8
# 关掉思考后 400 够用；如果开了思考就要提到 1500 以上，否则正文会被思考挤空
AI_MAX_TOKENS=400

# ---------- 人设 ----------
# 只写性格与说话方式。防幻觉的「铁律」由代码强制附加，人设怎么写都覆盖不掉。
AI_SYSTEM_PROMPT=

# ---------- 联网搜索（可选，需要厂商控制台先开通插件）----------
AI_WEB_SEARCH_ENABLED=false
AI_WEB_SEARCH_FORCE=false
AI_WEB_SEARCH_MAX_KEYWORD=2
# auto = 命中时效性关键词才联网（推荐）；always = 每条消息都挂（慢约 1.2 秒）
AI_WEB_SEARCH_TRIGGER=auto
AI_WEB_SEARCH_DAILY_LIMIT=30

# ---------- 群资源 / 精华 / 成员 ----------
AI_FILE_SEARCH_ENABLED=true
AI_FILE_INDEX_TTL=600
AI_FILE_MAX_RESULTS=15
AI_ESSENCE_ENABLED=true
AI_ESSENCE_INDEX_TTL=900
AI_MEMBER_ENABLED=true
AI_MEMBER_INDEX_TTL=1800
AI_MEMBER_MAX_RESULTS=5
AI_HISTORY_ENABLED=true

# ---------- 群文件内容检索（RAG）----------
AI_FILETEXT_ENABLED=true
AI_FILETEXT_MAX_FILES=20
AI_FILETEXT_MAX_FILE_SIZE=8388608

# ---------- 入群欢迎 / 表情包 ----------
AI_WELCOME_ENABLED=true
AI_WELCOME_COOLDOWN=15
AI_WELCOME_DAILY_LIMIT=20
AI_STICKER_ENABLED=false
AI_STICKER_DIR=stickers
AI_STICKER_PROBABILITY=0

# ---------- 识图 ----------
# 纯文本模型（deepseek-chat / glm-4-flash 等）收到图会 400，必须改成 false
AI_VISION_ENABLED=true
AI_VISION_MAX_IMAGES=3
# url = 把图片地址给模型（快）；base64 = 编码后塞进请求（稳）
AI_VISION_IMAGE_MODE=url

# ---------- 限流（防封号也防账单失控）----------
AI_COOLDOWN=5
AI_DAILY_LIMIT=200
# 留空 = 所有群可用；填了就只服务这些群，例如 [123456, 789012]
AI_GROUP_WHITELIST=[]
AI_REPLY_QUOTE=true

# ---------- 私聊 ----------
AI_PRIVATE_ENABLED=true
AI_PRIVATE_COOLDOWN=3
AI_PRIVATE_DAILY_LIMIT=100

# ============================================================
# 本地 ComfyUI 生图（可选）
#
# 前置条件：本机已经装好并启动 ComfyUI（默认 http://127.0.0.1:8188），
# 且 models/checkpoints 下至少有一个模型。
# 打开后群里可用：
#   /画 一只在雨里的猫            直接出图
#   /画图模型                     查看本机支持哪些模型、LoRA、采样器…
#   /comfy                        查看生图状态（在线与否、队列、额度）
# ============================================================

# 总开关。默认关闭：生图吃显存、耗时也长，按需打开
AI_IMAGE_ENABLED=false
# ComfyUI 地址。装在别的机器就换成 http://192.168.x.x:8188
AI_IMAGE_API_BASE=http://127.0.0.1:8188
# 默认检查点模型。留空 = 用该机第一个模型；名字要和 /画图模型 列出来的一致（可带子目录）
AI_IMAGE_DEFAULT_MODEL=
# 默认负向提示词，出图崩坏时改这里
AI_IMAGE_DEFAULT_NEGATIVE=低质量, 模糊, 变形, 多余的手指, 文字, 水印

# 默认出图参数（都能被 /画 命令里的 --参数 临时覆盖）
AI_IMAGE_STEPS=20
AI_IMAGE_CFG=7.0
AI_IMAGE_SAMPLER=euler
AI_IMAGE_SCHEDULER=normal
AI_IMAGE_WIDTH=512
AI_IMAGE_HEIGHT=512
# 宽高上限。8G 显存别超过 1024，否则容易爆显存
AI_IMAGE_MAX_WIDTH=1024
AI_IMAGE_MAX_HEIGHT=1024
# 一次出几张（1~4）
AI_IMAGE_BATCH=1

# 整轮生成最长等待（秒），模型大/步数高时调大
AI_IMAGE_TIMEOUT=180
# 轮询间隔（秒）
AI_IMAGE_POLL=0.8
# 生成结果保存目录（相对路径按项目根目录算）与最多保留张数，0 = 不清理
AI_IMAGE_SAVE_DIR=data/images
AI_IMAGE_KEEP=200

# 生图比聊天重，冷却与额度单独设（按群计）
AI_IMAGE_COOLDOWN=30
AI_IMAGE_DAILY_LIMIT=20
# 生成前先回一句「正在生成：…」，介意刷屏就改成 false
AI_IMAGE_ANNOUNCE=true
# 打开后 @机器人 说「画一张…」也会直接生图。默认关闭，用 /画 更可控
AI_IMAGE_NL_TRIGGER=false
# 模型清单缓存时长（秒）
AI_IMAGE_MODELS_TTL=300
# 提示词最长字数，超出截断
AI_IMAGE_MAX_PROMPT=300

# ---- /画 命令支持的参数 ----
#   --模型/--model 名称      指定检查点（支持模糊匹配，唯一命中即可）
#   --尺寸/--size 768x768    同时指定宽高（也可用 --宽/--高 分开写）
#   --步数/--steps 30
#   --cfg 7.5
#   --采样器/--sampler dpmpp_2m
#   --调度器/--scheduler karras
#   --种子/--seed 12345      固定种子可复现同一张图
#   --数量/--batch 2
#   -n / --负 负向提示词
# 例：/画 一只橘猫坐在窗台上 --尺寸 768x768 --步数 30 -n 模糊, 多余的手指
